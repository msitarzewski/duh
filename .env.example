# duh environment variables
# Copy to .env and fill in values. Never commit .env to git.

# Provider API keys (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
# MISTRAL_API_KEY=

# Cloudflare Workers AI (OpenAI-compatible) — enables the "cloudflare" provider
# (e.g. Zhipu GLM-5.2). Both must be set. ACCOUNT_ID is an identifier (in the
# URL); the token is a Workers AI API token with the "Workers AI: Run" permission.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN=

# JWT secret for auth tokens (required in production; auto-generated in dev if empty)
DUH_JWT_SECRET=

# Mail (SMTP) configuration for password reset emails
DUH_MAIL_HOST=localhost
DUH_MAIL_PORT=1025
DUH_MAIL_USERNAME=
DUH_MAIL_PASSWORD=
DUH_MAIL_ENCRYPTION=
DUH_MAIL_FROM_ADDRESS=noreply@example.com
DUH_MAIL_FROM_NAME=duh
